{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core editor and settings window permissions",
  "windows": [
    "main",
    "settings",
    "release"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "updater:default",
    "process:allow-restart"
  ]
}
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeaveCatcher",
  "version": "0.1.9",
  "identifier": "com.weavecatcher.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WeaveCatcher",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#f4f5f7",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://* data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' media-src 'self' asset: http://asset.localhost https://* data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5OEEwMDdFMzM1QUIyNUUKUldSZXNsb3pmZ0NLeVFGaXpyV3N5NnN2QjVuVkNDek9FOGtvUzFPeTNkMzNqZ3RTcnY4NjFDL0UK",
      "endpoints": [
        "https://github.com/scorpionlegend/WeaveCatcher/releases/latest/download/latest.json"
      ]
    }
  }
}